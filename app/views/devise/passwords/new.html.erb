<% content_for :title, "Recuperar senha" %>

<div class="auth-wrapper d-flex align-items-center justify-content-center">
  <div class="card auth-card shadow">
    <div class="card-body p-4 p-md-5">
      <h1 class="h4 text-center mb-1">Esqueceu sua senha?</h1>
      <p class="text-body-secondary text-center mb-4">Enviaremos as instruções para o seu e-mail.</p>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="form-floating mb-3">
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "email@exemplo.com", required: true %>
          <%= f.label :email, "E-mail" %>
        </div>

        <%= f.submit "Enviar instruções", class: "btn btn-primary w-100" %>
      <% end %>

      <div class="text-center mt-3">
        <%= link_to "Voltar para o login", new_session_path(resource_name), class: "small" %>
      </div>
    </div>
  </div>
</div>
