<% content_for :title, "Nova senha" %>

<div class="auth-wrapper d-flex align-items-center justify-content-center">
  <div class="card auth-card shadow">
    <div class="card-body p-4 p-md-5">
      <h1 class="h4 text-center mb-4">Definir nova senha</h1>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div class="form-floating mb-3">
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control", placeholder: "Nova senha" %>
          <%= f.label :password, "Nova senha" %>
          <% if @minimum_password_length %>
            <div class="form-text">Mínimo de <%= @minimum_password_length %> caracteres.</div>
          <% end %>
        </div>

        <div class="form-floating mb-3">
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", placeholder: "Confirmação" %>
          <%= f.label :password_confirmation, "Confirme a nova senha" %>
        </div>

        <%= f.submit "Alterar senha", class: "btn btn-primary w-100" %>
      <% end %>
    </div>
  </div>
</div>
