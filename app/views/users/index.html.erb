<% content_for :title, "Usuários" %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <h1 class="h3 mb-0"><i class="bi bi-people me-2"></i>Usuários</h1>
  <%= link_to new_user_path, class: "btn btn-primary" do %>
    <i class="bi bi-plus-lg"></i> Novo usuário
  <% end %>
</div>

<div class="card shadow-sm border-0">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th>Nome</th>
          <th>E-mail</th>
          <th class="d-none d-md-table-cell">Criado em</th>
          <th class="text-end">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td>
              <div class="d-flex align-items-center gap-2">
                <span class="avatar rounded-circle bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center fw-semibold">
                  <%= user.nome.to_s.first.upcase %>
                </span>
                <%= link_to user.nome, user, class: "text-decoration-none" %>
                <% if user == current_user %>
                  <span class="badge text-bg-secondary">você</span>
                <% end %>
              </div>
            </td>
            <td><%= user.email %></td>
            <td class="d-none d-md-table-cell"><%= l user.created_at, format: :short %></td>
            <td class="text-end text-nowrap">
              <%= link_to user, class: "btn btn-sm btn-outline-secondary", title: "Ver" do %>
                <i class="bi bi-eye"></i>
              <% end %>
              <%= link_to edit_user_path(user), class: "btn btn-sm btn-outline-primary", title: "Editar" do %>
                <i class="bi bi-pencil"></i>
              <% end %>
              <% unless user == current_user %>
                <%= button_to user, method: :delete, class: "btn btn-sm btn-outline-danger", title: "Excluir",
                      form_class: "d-inline", form: { data: { turbo_confirm: "Excluir #{user.nome}?" } } do %>
                  <i class="bi bi-trash"></i>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
