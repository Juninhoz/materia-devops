<%= form_with(model: user) do |form| %>
  <% if user.errors.any? %>
    <div class="alert alert-danger">
      <strong><%= pluralize(user.errors.count, "erro impediu", "erros impediram") %> o salvamento:</strong>
      <ul class="mb-0 mt-2 ps-3">
        <% user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :nome, "Nome", class: "form-label" %>
    <%= form.text_field :nome, class: "form-control #{'is-invalid' if user.errors[:nome].any?}", required: true %>
    <div class="invalid-feedback"><%= user.errors[:nome].to_sentence %></div>
  </div>

  <div class="mb-3">
    <%= form.label :email, "E-mail", class: "form-label" %>
    <%= form.email_field :email, class: "form-control #{'is-invalid' if user.errors[:email].any?}", required: true %>
    <div class="invalid-feedback"><%= user.errors[:email].to_sentence %></div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-6">
      <%= form.label :password, "Senha", class: "form-label" %>
      <%= form.password_field :password, autocomplete: "new-password",
            class: "form-control #{'is-invalid' if user.errors[:password].any?}" %>
      <div class="invalid-feedback"><%= user.errors[:password].to_sentence %></div>
      <% if user.persisted? %>
        <div class="form-text">Deixe em branco para manter a senha atual.</div>
      <% else %>
        <div class="form-text">Mínimo de <%= User.password_length.min %> caracteres.</div>
      <% end %>
    </div>
    <div class="col-md-6">
      <%= form.label :password_confirmation, "Confirmação de senha", class: "form-label" %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password",
            class: "form-control #{'is-invalid' if user.errors[:password_confirmation].any?}" %>
      <div class="invalid-feedback"><%= user.errors[:password_confirmation].to_sentence %></div>
    </div>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit "Salvar", class: "btn btn-primary" %>
    <%= link_to "Cancelar", user.persisted? ? user : users_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
