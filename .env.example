# Copie para .env (cp .env.example .env) e ajuste os valores.
# O .env é carregado automaticamente em desenvolvimento e teste (dotenv-rails).

# Banco de dados (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# Apenas produção: nome base do banco (cache/queue/cable usam sufixos)
# DATABASE_NAME=materia_devops_production

# Threads do Puma / conexões do banco
RAILS_MAX_THREADS=5
